#!/usr/bin/env python3
"""Thin wrapper around the vendored tailnetctl.py.

The vendored tool is unmodified. This wrapper only ensures the tool reads the
shared secret file instead of a .tailscale.env inside the skill directory.

Env file resolution:
    TAILNETCTL_ENV_FILE                 (explicit override)
    ~/.config/tailscale/tailnetctl.env  (default)

A user-supplied --env-file (or --env-file=...) always wins.

Read-only commands (status/list/ssh/web) run even when the env file is absent;
they do not need the auth key. `join` needs the key, so it stops with setup
instructions instead of failing deep inside the tool.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parents[1]
TOOL = SKILL_DIR / "scripts" / "tailnetctl.py"
DEFAULT_ENV_FILE = Path.home() / ".config" / "tailscale" / "tailnetctl.env"
ENV_EXAMPLE = SKILL_DIR / "references" / "env.example"

SUBCOMMANDS = {"join", "status", "list", "ssh", "web"}
# Global flags that take no value. --env-file takes a value and is skipped
# separately.
FLAGS_WITHOUT_VALUE = {
    "-h",
    "--help",
    "--sudo",
    "--no-sudo",
    "--no-start-daemon",
    "--debug",
}


def _has_env_arg(argv: list[str]) -> bool:
    return any(arg == "--env-file" or arg.startswith("--env-file=") for arg in argv)


def _find_subcommand(argv: list[str]) -> str | None:
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--env-file":
            index += 2
            continue
        if arg.startswith("--env-file="):
            index += 1
            continue
        if arg in FLAGS_WITHOUT_VALUE:
            index += 1
            continue
        if arg.startswith("-"):
            index += 1
            continue
        return arg
    return None


def _env_file_path() -> Path:
    return Path(os.environ.get("TAILNETCTL_ENV_FILE") or DEFAULT_ENV_FILE).expanduser()


def _print_setup_hint(env_file: Path) -> None:
    print(f"尚未設定 Tailscale env 檔：{env_file}", file=sys.stderr)
    print("", file=sys.stderr)
    print("加入 tailnet 需要 Tailscale auth key。請先完成：", file=sys.stderr)
    print(
        "  1) 建立 auth key: https://console.tailscale.com/admin/settings/keys",
        file=sys.stderr,
    )
    print("  2) 建立目錄與 0600 範本：", file=sys.stderr)
    print("       mkdir -p ~/.config/tailscale && chmod 700 ~/.config/tailscale", file=sys.stderr)
    print(f'       install -m 600 "{ENV_EXAMPLE}" "{env_file}"', file=sys.stderr)
    print(
        f"  3) 編輯 {env_file}，填入 TAILSCALE_AUTH_KEY 或 "
        "TAILSCALE_AUTH_KEY_FILE（不要在聊天中貼 key）",
        file=sys.stderr,
    )
    print(
        f'  4) 驗證：python3 "{SKILL_DIR / "scripts" / "check_setup"}"',
        file=sys.stderr,
    )


def main() -> None:
    args = sys.argv[1:]
    cmd = [sys.executable, str(TOOL)]

    if not _has_env_arg(args):
        env_file = _env_file_path()
        if env_file.exists():
            cmd.extend(["--env-file", str(env_file)])
        elif _find_subcommand(args) == "join":
            _print_setup_hint(env_file)
            sys.exit(2)

    cmd.extend(args)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
